<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal types (ContentReadStore, etc.) to the integration test project. -->
    <InternalsVisibleTo Include="GaiaSkyline.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GaiaSkyline.Application\GaiaSkyline.Application.csproj" />
    <ProjectReference Include="..\GaiaSkyline.Domain\GaiaSkyline.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Stage 5: external calendar iCal import (tolerant parser + HTTP resilience). -->
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="SendGrid" Version="9.29.3" />

    <!--
      ImageSharp generates the responsive raster variants (WebP + JPEG at 400/800/1600w) and the
      LQIP previews in the dev seeder. Pinned to the 2.1.x line, which is Apache-2.0 (3.x moved to
      the Six Labors Split License). AVIF has no managed encoder here, so real AVIF is deferred to
      the Stage 7 asset pipeline; see ADR 0008.
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.11" />
    <PackageReference Include="Stripe.net" Version="53.0.0" />

    <!--
      Security override: EF Core Design (design-time only) pulls in a transitive
      System.Security.Cryptography.Xml 9.0.0 which has known high-severity advisories.
      Pin the patched 10.0.x so the vulnerable-package scan stays clean.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

</Project>
