{
  "DetailedErrors": true,
  "Features": {
    "SeedContentOnStartup": true
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
