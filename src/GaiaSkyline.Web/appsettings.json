{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=GaiaSkyline;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "BackgroundJobs": {
    "Enabled": false
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "stay@gaiaskyline.com",
    "FromName": "Gaia Skyline",
    "OwnerAddress": "nuno_senica@hotmail.com",
    "SmtpHost": "localhost",
    "SmtpPort": 2525,
    "SendGridApiKey": "",
    "SiteBaseUrl": "https://localhost:7443"
  },
  "Booking": {
    "Pricing": {
      "_comment": "BaseNightlyRateEur is a PLACEHOLDER — set it to match the Airbnb listing (source of truth is the backend; see ADR 0009). CleaningFeeEur is 60 per the owner.",
      "BaseNightlyRateEur": 120,
      "CleaningFeeEur": 60,
      "StandardMinNights": 3,
      "LastMinuteWindowDays": 7,
      "LastMinuteMinNights": 1,
      "WeeklyDiscountPct": 0,
      "MonthlyDiscountPct": 0,
      "TouristTaxPerAdultPerNightEur": null,
      "TouristTaxMaxNights": null,
      "TouristTaxMinAgeExempt": null,
      "CancellationTiers": [
        { "DaysBeforeCheckIn": 1, "RefundPct": 100 }
      ]
    }
  },
  "Pricing": {
    "_comment": "Automatic nightly-price sync. Provider is None (manual) until a real PriceLabs/Hostify adapter exists — see ADR 0014. ApiKey is a credential: set it in User Secrets / Key Vault, never here.",
    "Provider": "None",
    "DirectBookingAdjustmentPct": 0,
    "FloorPrice": 1,
    "CeilingPrice": 100000,
    "SyncIntervalHours": 4
  },
  "AllowedHosts": "*"
}
