@using GaiaSkyline.Application.Content
@model GaiaSkyline.Web.Models.StoryEditViewModel
@{
    Layout = "_AdminShell";
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "New story" : "Edit story";
    var action = isNew ? "/admin/stories" : $"/admin/stories/{Model.Id}";
}

<div class="max-w-4xl">
    <nav class="text-sm text-ink/60 mb-2">
        <a href="/admin/stories" class="text-river hover:underline">Stories</a>
        <span class="mx-1">/</span>
        <span>@(isNew ? "New" : "Edit")</span>
    </nav>
    <h1 class="font-display text-2xl font-semibold">@(isNew ? "New story" : "Edit story")</h1>

    <form method="post" action="@action" data-content-editor class="mt-5 space-y-6">
        @Html.AntiForgeryToken()

        <div class="grid sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-semibold text-river" for="slug">Slug (English)</label>
                <input id="slug" name="Slug" value="@Model.Slug" maxlength="200"
                       class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm font-mono" />
                <p class="mt-1 text-xs text-ink/50">Leave blank to generate from the English title. Other languages set their own slug on their tab. The old URL 301-redirects if you change a published slug.</p>
            </div>
            <div>
                <label class="block text-xs font-semibold text-river" for="author">Author</label>
                <input id="author" name="AuthorName" value="@Model.AuthorName" maxlength="200"
                       class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-river" for="pubdate">Published date</label>
                <input id="pubdate" name="PublishedDate" type="date" value="@Model.PublishedDate.ToString("yyyy-MM-dd")"
                       class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm" />
            </div>
            <div class="flex items-end">
                <label class="inline-flex items-center gap-2 text-sm">
                    <input name="IsPublished" type="checkbox" value="true" @(Model.IsPublished ? "checked" : null) />
                    <span>Published (visible on the public site)</span>
                </label>
            </div>
        </div>

        <fieldset>
            <legend class="text-xs font-semibold text-river">Cover image</legend>
            @if (Model.Images.Count == 0)
            {
                <p class="mt-1 text-xs text-clay">No images yet — upload one in Media first.</p>
            }
            else
            {
                <div class="mt-2 grid grid-cols-3 sm:grid-cols-5 gap-2 max-h-64 overflow-y-auto p-1">
                    @foreach (var img in Model.Images)
                    {
                        var thumb = img.BlobUri.EndsWith("-1600.jpg", StringComparison.OrdinalIgnoreCase) ? img.BlobUri[..^"-1600.jpg".Length] + "-400.jpg" : img.BlobUri;
                        var on = img.Id == Model.CoverMediaAssetId;
                        <label class="block cursor-pointer rounded-md border @(on ? "border-clay ring-1 ring-clay" : "border-fog") overflow-hidden">
                            <input type="radio" name="CoverMediaAssetId" value="@img.Id" class="sr-only" @(on ? "checked" : null) />
                            <img src="@thumb" alt="" class="aspect-[3/2] w-full object-cover bg-fog" />
                        </label>
                    }
                </div>
            }
        </fieldset>

        <!-- Language tabs -->
        <div>
            <div class="flex flex-wrap gap-1 border-b border-fog" role="tablist">
                @for (var i = 0; i < Model.Translations.Count; i++)
                {
                    var l = Model.Translations[i];
                    var active = i == 0;
                    var empty = string.IsNullOrWhiteSpace(l.Title);
                    <button type="button" role="tab" data-lang-tab="@l.LanguageCode"
                            aria-selected="@(active ? "true" : "false")"
                            class="px-3 py-2 text-sm border-b-2 @(active ? "border-clay text-clay font-semibold" : "border-transparent text-ink/60")">
                        @ContentLanguages.ShortLabel(l.LanguageCode)
                        @if (empty)
                        {
                            <span class="ml-1 text-clay" title="No title yet">●</span>
                        }
                    </button>
                }
            </div>

            @for (var i = 0; i < Model.Translations.Count; i++)
            {
                var l = Model.Translations[i];
                var active = i == 0;
                <div data-lang-panel="@l.LanguageCode" class="@(active ? "" : "hidden") pt-4 space-y-3">
                    <input type="hidden" name="Translations[@i].LanguageCode" value="@l.LanguageCode" />
                    <div>
                        <label class="block text-xs font-semibold text-river">Title</label>
                        <input name="Translations[@i].Title" value="@l.Title" maxlength="300"
                               class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm" />
                    </div>
                    @if (!string.Equals(l.LanguageCode, ContentLanguages.Default, StringComparison.OrdinalIgnoreCase))
                    {
                        <div>
                            <label class="block text-xs font-semibold text-river">Slug (@ContentLanguages.ShortLabel(l.LanguageCode))</label>
                            <input name="Translations[@i].Slug" value="@l.Slug" maxlength="200"
                                   placeholder="follows the English slug"
                                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm font-mono" />
                            <p class="mt-1 text-xs text-ink/50">This language's own URL. Auto-suggested from the title the first time; blank follows the English slug. Changing it on a published story 301-redirects the old URL.</p>
                        </div>
                    }
                    <div>
                        <label class="block text-xs font-semibold text-river">Excerpt</label>
                        <textarea name="Translations[@i].Excerpt" rows="2" maxlength="1000"
                                  class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm">@l.Excerpt</textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-river">Body</label>
                        <div class="gaia-richtext mt-1 border border-fog rounded-md bg-white" data-editor>
                            <div class="gaia-editor-toolbar flex gap-1 border-b border-fog p-1 text-sm">
                                <button type="button" data-cmd="bold" class="px-2 py-1 rounded hover:bg-stone"><b>B</b></button>
                                <button type="button" data-cmd="italic" class="px-2 py-1 rounded hover:bg-stone"><i>I</i></button>
                                <button type="button" data-cmd="bulletList" class="px-2 py-1 rounded hover:bg-stone">• List</button>
                                <button type="button" data-cmd="orderedList" class="px-2 py-1 rounded hover:bg-stone">1. List</button>
                                <button type="button" data-cmd="link" class="px-2 py-1 rounded hover:bg-stone">Link</button>
                                <button type="button" data-cmd="unlink" class="px-2 py-1 rounded hover:bg-stone">Unlink</button>
                            </div>
                            <div class="gaia-editor-mount px-3 py-2 min-h-[8rem]"></div>
                            <textarea name="Translations[@i].Body" class="gaia-editor-source hidden">@l.BodyRichText</textarea>
                        </div>
                        <p class="mt-1 text-xs text-ink/50">Bold, italic, links and lists are kept; everything else is stripped on save.</p>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-river">Meta title (SEO)</label>
                            <input name="Translations[@i].MetaTitle" value="@l.MetaTitle" maxlength="200"
                                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-river">Meta description (SEO)</label>
                            <input name="Translations[@i].MetaDescription" value="@l.MetaDescription" maxlength="400"
                                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm" />
                        </div>
                    </div>
                    @if (l.ReadingTimeMinutes > 0)
                    {
                        <p class="text-xs text-ink/45">Reading time: ~@l.ReadingTimeMinutes min (recomputed on save).</p>
                    }
                </div>
            }
        </div>

        <div class="flex items-center gap-3 border-t border-fog pt-4">
            <button type="submit" class="bg-river text-white rounded-md px-5 py-2 text-sm">@(isNew ? "Create story" : "Save story")</button>
            <a href="/admin/stories" class="text-sm text-ink/60 hover:underline">Cancel</a>
        </div>
    </form>

    @if (!isNew)
    {
        @if (Model.PreviousSlugs is { Count: > 0 })
        {
            <p class="mt-4 text-xs text-ink/45">Old slugs redirecting here: @string.Join(", ", Model.PreviousSlugs)</p>
        }
        <div class="mt-6 border-t border-fog pt-4">
            <h2 class="font-display text-sm font-semibold text-ink/80">Delete</h2>
            <form method="post" action="/admin/stories/@Model.Id/delete" class="mt-2"
                  data-confirm="Delete this story? This cannot be undone.">
                @Html.AntiForgeryToken()
                <button type="submit" class="text-sm text-clay hover:underline">Delete story</button>
            </form>
        </div>
    }
</div>

<script src="~/js/admin/editor.bundle.js" asp-append-version="true"></script>
<script src="~/js/content-admin.js" asp-append-version="true"></script>
