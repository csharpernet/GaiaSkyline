@using GaiaSkyline.Application.Content
@model IReadOnlyList<GaiaSkyline.Application.Content.StoryListItemDto>
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Stories";
}

<div class="max-w-5xl">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="font-display text-2xl font-semibold">Stories</h1>
            <p class="mt-1 text-sm text-ink/70">@Model.Count story(ies). Each has a shared slug and per-language content.</p>
        </div>
        <a href="/admin/stories/create" class="shrink-0 bg-river text-white rounded-md px-4 py-2 text-sm">New story</a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="mt-8 text-sm text-ink/55">No stories yet. Create the first one.</p>
    }
    else
    {
        <table class="mt-6 w-full text-sm">
            <thead class="text-left text-ink/50 border-b border-fog">
                <tr><th class="py-2">Title</th><th>Slug</th><th>Status</th><th>Languages</th><th>Published</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr class="border-b border-fog hover:bg-stone/40">
                        <td class="py-2">
                            <a href="/admin/stories/@s.Id" class="flex items-center gap-3 text-river hover:underline">
                                @if (!string.IsNullOrEmpty(s.CoverThumbBlobUri))
                                {
                                    <img src="@s.CoverThumbBlobUri" alt="" class="h-10 w-16 rounded object-cover bg-fog" />
                                }
                                <span class="font-medium text-ink">@s.Title</span>
                            </a>
                        </td>
                        <td class="font-mono text-xs text-ink/60">@s.Slug</td>
                        <td>
                            @if (s.IsPublished)
                            {
                                <span class="text-xs uppercase tracking-wide border border-river text-river rounded px-2 py-0.5">Published</span>
                            }
                            else
                            {
                                <span class="text-xs uppercase tracking-wide border border-ink/30 text-ink/60 rounded px-2 py-0.5">Draft</span>
                            }
                        </td>
                        <td class="text-xs text-ink/70">
                            @s.LanguageCount/@ContentLanguages.All.Count
                            @if (s.MissingLanguageCount > 0)
                            {
                                <span class="ml-1 text-clay" title="Missing translations">● @s.MissingLanguageCount missing</span>
                            }
                        </td>
                        <td class="text-xs text-ink/60">@s.PublishedAtUtc.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
