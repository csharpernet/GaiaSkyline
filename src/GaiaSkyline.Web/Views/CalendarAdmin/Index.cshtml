@using GaiaSkyline.Application.Admin
@model GaiaSkyline.Web.Models.CalendarAdminViewModel
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Calendar";
    var p = Model.Period;

    // Same colours as the dashboard month calendar.
    string ChipClass(CalendarItemKind k) => k switch
    {
        CalendarItemKind.DirectBooking => "bg-clay text-white",
        CalendarItemKind.ImportedBlock => "bg-river text-white",
        CalendarItemKind.ExternalOwnerBlock => "bg-[#C98A3A] text-white",
        CalendarItemKind.OwnerUnavailable => "bg-fog text-ink/80",
        _ => "bg-white",
    };
    string Qs(DateOnly anchor) => $"/admin/calendar?view={Model.View}&anchor={anchor:yyyy-MM-dd}";
    var periodLabel = Model.View == "week"
        ? $"Week of {p.From:yyyy-MM-dd}"
        : Model.Anchor.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="max-w-6xl">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="font-display text-2xl font-semibold">Calendar</h1>
            <p class="mt-1 text-sm text-ink/70">@p.CalendarStatus</p>
        </div>
        <form method="post" action="/admin/calendar/reimport">
            @Html.AntiForgeryToken()
            <input type="hidden" name="view" value="@Model.View" />
            <input type="hidden" name="anchor" value="@Model.Anchor.ToString("yyyy-MM-dd")" />
            <button type="submit" data-force-reimport disabled="@p.ManualMode"
                    class="rounded-md px-4 py-2 text-sm @(p.ManualMode ? "border border-fog text-ink/40 cursor-not-allowed" : "border border-river text-river")">
                Force iCal re-import
            </button>
            @if (p.ManualMode)
            {
                <p class="mt-1 max-w-56 text-xs text-ink/50" data-reimport-explanation>
                    Disabled in manual mode — connect an external calendar in Settings first.
                </p>
            }
        </form>
    </div>

    <!-- Navigation + view toggle -->
    <div class="mt-4 flex flex-wrap items-center gap-2">
        <a href="@Qs(Model.PrevAnchor)" class="border border-fog rounded-md px-3 py-1.5 text-sm hover:bg-stone/40">←</a>
        <span class="min-w-40 text-center text-sm font-semibold">@periodLabel</span>
        <a href="@Qs(Model.NextAnchor)" class="border border-fog rounded-md px-3 py-1.5 text-sm hover:bg-stone/40">→</a>
        <a href="/admin/calendar?view=@Model.View" class="border border-fog rounded-md px-3 py-1.5 text-sm hover:bg-stone/40">Today</a>
        <span class="mx-2 text-fog">|</span>
        <a href="/admin/calendar?view=month&anchor=@Model.Anchor.ToString("yyyy-MM-dd")"
           class="rounded-md px-3 py-1.5 text-sm @(Model.View == "month" ? "bg-river text-white" : "border border-fog hover:bg-stone/40")">Month</a>
        <a href="/admin/calendar?view=week&anchor=@Model.Anchor.ToString("yyyy-MM-dd")"
           class="rounded-md px-3 py-1.5 text-sm @(Model.View == "week" ? "bg-river text-white" : "border border-fog hover:bg-stone/40")">Week</a>
        <a href="/admin/calendar/duplicates" class="ml-auto text-sm text-river hover:underline">
            Duplicate cleanup@(p.DuplicateCount > 0 ? $" ({p.DuplicateCount})" : "")
        </a>
    </div>

    <!-- Legend (same colours as the dashboard) -->
    <div class="mt-3 flex flex-wrap gap-4 text-xs text-ink/70" data-calendar-legend>
        <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-sm bg-clay"></span> Direct booking (in ICS export)</span>
        <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-sm bg-river"></span> Imported iCal block</span>
        <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-sm bg-[#C98A3A]"></span> External booking (owner block, not exported)</span>
        <span class="flex items-center gap-1.5"><span class="inline-block h-3 w-3 rounded-sm bg-fog"></span> Owner unavailable (in ICS export)</span>
    </div>

    <!-- Grid -->
    <div class="mt-4 grid grid-cols-7 gap-px rounded-md border border-fog bg-fog text-xs">
        @foreach (var dayName in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
        {
            <div class="bg-stone/60 px-2 py-1 font-semibold text-ink/60">@dayName</div>
        }
        @foreach (var cell in p.Cells)
        {
            <div class="@(cell.InPeriod ? "bg-white" : "bg-stone/40") @(Model.View == "week" ? "min-h-36" : "min-h-20") px-1.5 py-1" data-cal-cell="@cell.Date.ToString("yyyy-MM-dd")">
                <div class="@(cell.InPeriod ? "text-ink/70" : "text-ink/35") font-medium">@cell.Date.Day</div>
                <div class="mt-0.5 space-y-0.5">
                    @foreach (var item in cell.Items)
                    {
                        <div class="truncate rounded px-1 py-0.5 @ChipClass(item.Kind)"
                             title="@item.Label@(string.IsNullOrEmpty(item.Note) ? "" : $" — {item.Note}") (@(item.InIcsExport ? "in ICS export" : "not exported"))">
                            @item.Label
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Quick add -->
    <section class="mt-6 rounded-md border border-fog bg-white p-4">
        <h2 class="text-sm font-semibold text-ink/80">Add a block</h2>
        <p class="mt-1 text-xs text-ink/55">
            "External booking" mirrors a reservation that lives in Hostify/Airbnb (blocks the calendar, not exported).
            "Owner unavailable" holds dates for yourself (exported over ICS).
        </p>
        <form method="post" action="/admin/calendar/blocks" class="mt-3 flex flex-wrap items-end gap-3" data-add-block-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="view" value="@Model.View" />
            <div>
                <label class="block text-xs font-semibold text-river" for="start">First night</label>
                <input id="start" name="start" type="date" required class="mt-1 rounded-md border border-fog px-3 py-2 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-river" for="end">End (first free night)</label>
                <input id="end" name="end" type="date" required class="mt-1 rounded-md border border-fog px-3 py-2 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-river" for="kind">Kind</label>
                <select id="kind" name="kind" class="mt-1 rounded-md border border-fog px-3 py-2 text-sm">
                    <option value="external-booking">External booking</option>
                    <option value="owner-unavailable">Owner unavailable</option>
                </select>
            </div>
            <div class="grow">
                <label class="block text-xs font-semibold text-river" for="note">Note (e.g. "Airbnb — Hostify email 3 Oct")</label>
                <input id="note" name="note" maxlength="500" class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm" />
            </div>
            <button type="submit" class="bg-river text-white rounded-md px-4 py-2 text-sm">Add block</button>
        </form>
    </section>

    <!-- Blocks in this period -->
    <section class="mt-5 rounded-md border border-fog bg-white p-4">
        <h2 class="text-sm font-semibold text-ink/80">Blocks in this period</h2>
        @if (p.Blocks.Count == 0)
        {
            <p class="mt-2 text-sm text-ink/55">No owner blocks in this period.</p>
        }
        else
        {
            <ul class="mt-2 divide-y divide-fog/60">
                @foreach (var block in p.Blocks)
                {
                    <li class="py-2" data-block-row="@block.OwnerBlockId">
                        <div class="flex flex-wrap items-center gap-2 text-sm">
                            <span class="rounded px-2 py-0.5 text-xs @ChipClass(block.Kind)">@block.Label</span>
                            <span class="font-mono text-xs">@block.StartDate.ToString("yyyy-MM-dd") → @block.EndDateExclusive.ToString("yyyy-MM-dd")</span>
                            <span class="text-xs @(block.InIcsExport ? "text-river" : "text-ink/50")">
                                @(block.InIcsExport ? "in ICS export" : "not exported")
                            </span>
                            @if (!string.IsNullOrEmpty(block.Note))
                            {
                                <span class="text-xs text-ink/60">— @block.Note</span>
                            }
                            <details class="ml-auto">
                                <summary class="cursor-pointer text-xs text-river hover:underline">Edit</summary>
                                <form method="post" action="/admin/calendar/blocks/@block.OwnerBlockId/update"
                                      class="mt-2 flex flex-wrap items-end gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="view" value="@Model.View" />
                                    <input type="hidden" name="anchor" value="@Model.Anchor.ToString("yyyy-MM-dd")" />
                                    <input name="start" type="date" required value="@block.StartDate.ToString("yyyy-MM-dd")"
                                           class="rounded-md border border-fog px-2 py-1.5 text-xs" />
                                    <input name="end" type="date" required value="@block.EndDateExclusive.ToString("yyyy-MM-dd")"
                                           class="rounded-md border border-fog px-2 py-1.5 text-xs" />
                                    <input name="note" value="@block.Note" maxlength="500" placeholder="Note"
                                           class="w-56 rounded-md border border-fog px-2 py-1.5 text-xs" />
                                    <button type="submit" class="border border-river text-river rounded-md px-3 py-1.5 text-xs">Save</button>
                                </form>
                            </details>
                            <form method="post" action="/admin/calendar/blocks/@block.OwnerBlockId/delete"
                                  data-confirm="Remove this block and free its dates? Type DELETE to confirm." data-confirm-type="DELETE">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="view" value="@Model.View" />
                                <input type="hidden" name="anchor" value="@Model.Anchor.ToString("yyyy-MM-dd")" />
                                <button type="submit" class="text-xs text-clay hover:underline">Delete</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <!-- Conflicts -->
    <section class="mt-5 rounded-md border @(p.OpenConflicts.Count > 0 ? "border-clay/60" : "border-fog") bg-white p-4" data-conflicts>
        <h2 class="text-sm font-semibold @(p.OpenConflicts.Count > 0 ? "text-clay" : "text-ink/80")">
            Booking conflicts (@p.OpenConflicts.Count open)
        </h2>
        @if (p.OpenConflicts.Count == 0)
        {
            <p class="mt-2 text-sm text-ink/55">No open conflicts — imported calendars don't collide with any direct booking.</p>
        }
        else
        {
            <ul class="mt-2 divide-y divide-fog/60">
                @foreach (var conflict in p.OpenConflicts)
                {
                    <li class="py-2 text-sm" data-conflict-row="@conflict.Id">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="font-mono text-xs text-clay">@conflict.BookingReference</span>
                            <span class="text-xs text-ink/60">collides with @conflict.SourceName over</span>
                            <span class="font-mono text-xs">@conflict.StartDate.ToString("yyyy-MM-dd") → @conflict.EndDate.ToString("yyyy-MM-dd")</span>
                            <span class="text-xs text-ink/40">detected @conflict.DetectedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
                            @if (conflict.BookingId is { } bookingId)
                            {
                                <a href="/admin/bookings/@bookingId" class="text-xs text-river hover:underline">Open booking</a>
                            }
                            else
                            {
                                <a href="/admin/bookings?q=@conflict.BookingReference" class="text-xs text-river hover:underline">Find booking</a>
                            }
                            <a href="/admin/calendar?view=month&anchor=@conflict.StartDate.ToString("yyyy-MM-dd")"
                               class="text-xs text-river hover:underline">View dates</a>
                        </div>
                        <form method="post" action="/admin/calendar/conflicts/@conflict.Id/resolve" class="mt-2 flex flex-wrap items-end gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="view" value="@Model.View" />
                            <input type="hidden" name="anchor" value="@Model.Anchor.ToString("yyyy-MM-dd")" />
                            <input name="note" maxlength="500" placeholder="How was it handled? (optional)"
                                   class="w-72 max-w-full rounded-md border border-fog px-2 py-1.5 text-xs" />
                            <button type="submit" class="border border-river text-river rounded-md px-3 py-1.5 text-xs">Mark resolved</button>
                        </form>
                    </li>
                }
            </ul>
        }
    </section>
</div>
