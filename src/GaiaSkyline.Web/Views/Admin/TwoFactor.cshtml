@model TwoFactorViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Two-factor";
}

<h1 class="font-display text-2xl font-semibold">Two-factor authentication</h1>
<p class="mt-2 text-sm text-ink/70">Enter the 6-digit code from your authenticator app.</p>

<form asp-action="TwoFactor" method="post" class="mt-6 space-y-5">
    <div asp-validation-summary="ModelOnly" class="text-clay text-sm"></div>
    <div>
        <label asp-for="Code" class="block text-sm font-semibold text-river">Code</label>
        <input asp-for="Code" autocomplete="one-time-code" inputmode="numeric"
               class="mt-1 w-full rounded-md border border-fog px-3 py-2 bg-white" />
        <span asp-validation-for="Code" class="text-clay text-sm"></span>
    </div>
    <label class="flex items-center gap-2 text-sm text-ink/80">
        <input asp-for="IsRecoveryCode" type="checkbox" /> This is a recovery code
    </label>
    <button type="submit" class="w-full bg-clay text-white px-6 py-3 rounded-md hover:opacity-90 transition-opacity">
        Verify
    </button>
</form>
