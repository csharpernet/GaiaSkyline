@using System.Globalization
@model IReadOnlyList<GaiaSkyline.Application.Partners.CommissionRowDto>
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Commissions";
    static string Eur(decimal v) => "€" + v.ToString("0.00", CultureInfo.InvariantCulture);
}

<div class="max-w-5xl">
    <nav class="text-sm text-ink/60 mb-2">
        <a href="/admin/partners" class="text-river hover:underline">Partners</a>
        <span class="mx-1">/</span>
        <span>Commissions ledger</span>
    </nav>
    <h1 class="font-display text-2xl font-semibold">Commissions ledger</h1>
    <p class="mt-1 text-sm text-ink/70">Every commission, newest first. Basis = total − tourist tax − cleaning − refunds (ADR 0020).</p>

    @if (Model.Count == 0)
    {
        <p class="mt-8 text-sm text-ink/55">No commissions yet.</p>
    }
    else
    {
        <div class="mt-5 overflow-x-auto rounded-md border border-fog bg-white">
            <table class="w-full text-sm">
                <thead class="border-b border-fog text-left text-xs uppercase tracking-wide text-ink/50">
                    <tr>
                        <th class="px-3 py-2">Partner</th><th class="px-3 py-2">Booking</th><th class="px-3 py-2">Stay</th>
                        <th class="px-3 py-2 text-right">Basis</th><th class="px-3 py-2 text-right">%</th>
                        <th class="px-3 py-2 text-right">Amount</th><th class="px-3 py-2">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="border-b border-fog/60 last:border-0">
                            <td class="px-3 py-2"><a class="text-river hover:underline" href="/admin/partners/@c.PartnerId">@c.PartnerName</a></td>
                            <td class="px-3 py-2 font-mono">@c.BookingReference</td>
                            <td class="px-3 py-2">@c.CheckIn.ToString("d MMM", CultureInfo.InvariantCulture)–@c.CheckOut.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                            <td class="px-3 py-2 text-right">@Eur(c.BasisEur)</td>
                            <td class="px-3 py-2 text-right">@c.Pct%</td>
                            <td class="px-3 py-2 text-right">@Eur(c.AmountEur)</td>
                            <td class="px-3 py-2">@c.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
