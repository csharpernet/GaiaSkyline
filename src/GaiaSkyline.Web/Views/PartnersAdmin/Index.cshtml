@model IReadOnlyList<GaiaSkyline.Application.Partners.PartnerApplicationDto>
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Partners";
    var pending = Model.Count(a => a.Status == "Pending");
}

<div class="max-w-4xl">
    <h1 class="font-display text-2xl font-semibold">Partner applications</h1>
    <p class="mt-1 text-sm text-ink/70">
        @pending pending of @Model.Count. The partner program itself (portal, promo attribution) ships in
        Stage 8 — this queue just records your decision per application.
    </p>

    @if (Model.Count == 0)
    {
        <p class="mt-8 text-sm text-ink/55" data-no-applications>No applications yet.</p>
    }

    <section class="mt-5 space-y-3">
        @foreach (var application in Model)
        {
            <div class="rounded-md border @(application.Status == "Pending" ? "border-amber-600/50" : "border-fog") bg-white p-4"
                 data-application-row="@application.Email">
                <div class="flex flex-wrap items-center gap-3 text-sm">
                    <span class="font-semibold">@application.Name</span>
                    <span class="text-xs text-ink/55">@application.Email</span>
                    @if (application.AudienceSize is { } audience)
                    {
                        <span class="text-xs text-ink/55">audience @audience.ToString("N0")</span>
                    }
                    @if (!string.IsNullOrEmpty(application.Niche))
                    {
                        <span class="rounded bg-stone px-2 py-0.5 text-xs text-ink/70">@application.Niche</span>
                    }
                    <span class="ml-auto rounded px-2 py-0.5 text-xs uppercase tracking-wide
                        @(application.Status switch
                        {
                            "Pending" => "bg-amber-600/10 text-amber-600",
                            "Approved" => "bg-river/10 text-river",
                            _ => "bg-clay/10 text-clay",
                        })">@application.Status</span>
                </div>
                @if (!string.IsNullOrEmpty(application.SocialLinks))
                {
                    <p class="mt-1 text-xs text-ink/60 break-all">@application.SocialLinks</p>
                }
                @if (!string.IsNullOrEmpty(application.Message))
                {
                    <p class="mt-2 text-sm text-ink/80">@application.Message</p>
                }
                <p class="mt-1 text-xs text-ink/45">
                    Submitted @application.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC@(application.DecidedAtUtc is { } decided
                        ? $" · decided {decided:yyyy-MM-dd HH:mm} UTC{(string.IsNullOrEmpty(application.DecisionNote) ? "" : $" — {application.DecisionNote}")}"
                        : "")
                </p>
                @if (application.Status == "Pending")
                {
                    <div class="mt-3 flex flex-wrap items-end gap-2">
                        <input name="note" form="decision-@application.Id" placeholder="Decision note (optional)"
                               class="w-72 max-w-full rounded-md border border-fog px-3 py-2 text-sm" />
                        <form id="decision-@application.Id" method="post" action="/admin/partners/@application.Id/approve">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="bg-river text-white rounded-md px-4 py-2 text-sm">Approve</button>
                        </form>
                        <form method="post" action="/admin/partners/@application.Id/reject" data-reject-form
                              data-confirm="Reject @application.Name's application?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="note" data-copy-note />
                            <button type="submit" class="border border-clay text-clay rounded-md px-4 py-2 text-sm">Reject</button>
                        </form>
                    </div>
                }
            </div>
        }
    </section>
</div>

<script src="~/js/partners-admin.js" asp-append-version="true"></script>
