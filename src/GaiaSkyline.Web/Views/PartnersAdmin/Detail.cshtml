@using System.Globalization
@model GaiaSkyline.Application.Partners.PartnerAdminDetailDto
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Partner";
    static string Eur(decimal v) => "€" + v.ToString("0.00", CultureInfo.InvariantCulture);
}

<div class="max-w-4xl">
    <nav class="text-sm text-ink/60 mb-2">
        <a href="/admin/partners" class="text-river hover:underline">Partners</a>
        <span class="mx-1">/</span>
        <span>@Model.Name</span>
    </nav>
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="font-display text-2xl font-semibold">@Model.Name
            <span class="ml-2 rounded px-2 py-0.5 text-xs uppercase tracking-wide
                @(Model.Status == "Active" ? "bg-river/10 text-river" : Model.Status == "Suspended" ? "bg-clay/10 text-clay" : "bg-amber-600/10 text-amber-600")">
                @Model.Status
            </span>
        </h1>
        <div class="flex gap-2">
            @if (Model.Status == "Active")
            {
                <form method="post" action="/admin/partners/@Model.Id/suspend"
                      data-confirm="Suspend @Model.Name? Their code and links stop attributing immediately.">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="border border-clay text-clay rounded-md px-4 py-2 text-sm">Suspend</button>
                </form>
            }
            else if (Model.Status == "Suspended")
            {
                <form method="post" action="/admin/partners/@Model.Id/reactivate">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bg-river text-white rounded-md px-4 py-2 text-sm">Reactivate</button>
                </form>
            }
            else
            {
                <form method="post" action="/admin/partners/@Model.Id/resend-invite">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bg-river text-white rounded-md px-4 py-2 text-sm">Resend invite</button>
                </form>
            }
        </div>
    </div>

    <dl class="mt-4 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
        <div><dt class="text-ink/50 inline">Email:</dt> <dd class="inline">@Model.Email</dd></div>
        <div><dt class="text-ink/50 inline">Joined:</dt> <dd class="inline">@(Model.ActivatedAtUtc?.ToString("yyyy-MM-dd") ?? "not yet")</dd></div>
        <div><dt class="text-ink/50 inline">Terms accepted:</dt> <dd class="inline">@(Model.TermsAcceptedAtUtc is { } t ? $"{t:yyyy-MM-dd} (v{Model.TermsVersion})" : "—")</dd></div>
        <div><dt class="text-ink/50 inline">Payout:</dt> <dd class="inline">@(Model.PayoutIbanMasked ?? "—") · @(Model.PayoutAccountHolder ?? "—") · @(Model.PayoutTaxId ?? "—") (@(Model.PayoutCountry ?? "—"))</dd></div>
    </dl>

    <section class="mt-6 rounded-md border border-fog bg-white p-4">
        <h2 class="text-sm font-semibold text-ink/80">Code &amp; percentages</h2>
        <form method="post" action="/admin/partners/@Model.Id/update" class="mt-3 flex flex-wrap items-end gap-3">
            @Html.AntiForgeryToken()
            <div>
                <label for="pd-code" class="block text-xs font-semibold text-river">Promo code</label>
                <input id="pd-code" name="promoCode" value="@Model.PromoCode" required maxlength="20"
                       class="mt-1 w-40 rounded-md border border-fog px-3 py-2 text-sm font-mono uppercase" />
            </div>
            <div>
                <label for="pd-discount" class="block text-xs font-semibold text-river">Guest discount %</label>
                <input id="pd-discount" name="guestDiscountPct" type="number" min="0" max="100" value="@Model.GuestDiscountPct"
                       class="mt-1 w-28 rounded-md border border-fog px-3 py-2 text-sm" />
            </div>
            <div>
                <label for="pd-commission" class="block text-xs font-semibold text-river">Commission %</label>
                <input id="pd-commission" name="commissionPct" type="number" min="0" max="100" value="@Model.CommissionPct"
                       class="mt-1 w-28 rounded-md border border-fog px-3 py-2 text-sm" />
            </div>
            <button type="submit" class="bg-river text-white rounded-md px-4 py-2 text-sm">Save</button>
        </form>
    </section>

    <section class="mt-6">
        <h2 class="text-sm font-semibold text-ink/80">Commissions (@Model.Commissions.Count)</h2>
        @if (Model.Commissions.Count == 0)
        {
            <p class="mt-2 text-sm text-ink/55">None yet.</p>
        }
        else
        {
            <div class="mt-2 overflow-x-auto rounded-md border border-fog bg-white">
                <table class="w-full text-sm">
                    <thead class="border-b border-fog text-left text-xs uppercase tracking-wide text-ink/50">
                        <tr>
                            <th class="px-3 py-2">Booking</th><th class="px-3 py-2">Stay</th>
                            <th class="px-3 py-2 text-right">Basis</th><th class="px-3 py-2 text-right">%</th>
                            <th class="px-3 py-2 text-right">Amount</th><th class="px-3 py-2">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Commissions)
                        {
                            <tr class="border-b border-fog/60 last:border-0">
                                <td class="px-3 py-2 font-mono">@c.BookingReference</td>
                                <td class="px-3 py-2">@c.CheckIn.ToString("d MMM", CultureInfo.InvariantCulture)–@c.CheckOut.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                                <td class="px-3 py-2 text-right">@Eur(c.BasisEur)</td>
                                <td class="px-3 py-2 text-right">@c.Pct%</td>
                                <td class="px-3 py-2 text-right">@Eur(c.AmountEur)</td>
                                <td class="px-3 py-2">@c.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mt-6">
        <h2 class="text-sm font-semibold text-ink/80">Payouts (@Model.Payouts.Count)</h2>
        @if (Model.Payouts.Count == 0)
        {
            <p class="mt-2 text-sm text-ink/55">None yet.</p>
        }
        else
        {
            <ul class="mt-2 space-y-1 text-sm">
                @foreach (var p in Model.Payouts)
                {
                    <li class="flex flex-wrap items-center gap-3 rounded-md border border-fog bg-white px-3 py-2">
                        <span><strong>@p.PeriodLabel</strong> · @Eur(p.AmountEur) · @p.Status</span>
                        <a class="text-river hover:underline" href="/admin/partners/payouts/@p.Id/statement.pdf">Statement</a>
                    </li>
                }
            </ul>
        }
    </section>
</div>
