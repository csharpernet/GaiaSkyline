@model IReadOnlyList<GaiaSkyline.Application.Partners.PartnerClicksReportRow>
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Partner clicks";
}

<div class="max-w-3xl">
    <nav class="text-sm text-ink/60 mb-2">
        <a href="/admin/partners" class="text-river hover:underline">Partners</a>
        <span class="mx-1">/</span>
        <span>Clicks report</span>
    </nav>
    <h1 class="font-display text-2xl font-semibold">Clicks — last 30 days</h1>
    <p class="mt-1 text-sm text-ink/70">Referral-link visits per partner per day (unique = distinct anonymous visitors; no IPs are stored).</p>

    @if (Model.Count == 0)
    {
        <p class="mt-8 text-sm text-ink/55">No clicks recorded in the last 30 days.</p>
    }
    else
    {
        <div class="mt-5 overflow-x-auto rounded-md border border-fog bg-white">
            <table class="w-full text-sm">
                <thead class="border-b border-fog text-left text-xs uppercase tracking-wide text-ink/50">
                    <tr>
                        <th class="px-3 py-2">Day</th><th class="px-3 py-2">Partner</th>
                        <th class="px-3 py-2 text-right">Clicks</th><th class="px-3 py-2 text-right">Unique</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr class="border-b border-fog/60 last:border-0">
                            <td class="px-3 py-2">@row.Day.ToString("yyyy-MM-dd")</td>
                            <td class="px-3 py-2"><a class="text-river hover:underline" href="/admin/partners/@row.PartnerId">@row.PartnerName</a></td>
                            <td class="px-3 py-2 text-right">@row.Clicks</td>
                            <td class="px-3 py-2 text-right">@row.UniqueVisitors</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
