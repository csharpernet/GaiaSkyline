@model StoryDetailViewModel
@{
    var slug = SupportedCultures.SlugForCulture(System.Globalization.CultureInfo.CurrentUICulture.Name);
    var story = Model.Story;
}
<article class="max-w-3xl mx-auto px-6 py-12">
    <header>
        <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-tight">@story.Title</h1>
        <p class="mt-4 text-sm text-river">
            By <a id="story-author" rel="author" href="/@slug#host-card" class="hover:text-clay">@story.AuthorName</a>
            · <time datetime="@story.PublishedAtUtc.ToString("yyyy-MM-dd")">@story.PublishedAtUtc.ToString("d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</time>
            · @story.ReadingTimeMinutes min read
        </p>
    </header>

    @if (story.Cover is not null)
    {
        @await Html.PartialAsync("_Picture", ResponsiveImage.From(
            story.Cover,
            sizes: "(min-width: 768px) 768px, 100vw",
            wrapperClass: "mt-8 rounded-lg aspect-[3/2]",
            eager: true,
            highPriority: true))
    }

    <div class="mt-8 prose prose-lg max-w-none text-ink/90 leading-relaxed">
        @Html.Raw(story.BodyRichText)
    </div>
</article>

@if (Model.Related.Count > 0)
{
    <section class="max-w-6xl mx-auto px-6 py-12 border-t border-fog" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-display text-2xl font-semibold">Related stories</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
            @foreach (var related in Model.Related)
            {
                <a href="/@slug/stories/@related.Slug" class="group block bg-white rounded-lg p-5 shadow-sm">
                    <h3 class="font-display text-lg font-semibold group-hover:text-clay">@related.Title</h3>
                    <p class="mt-1 text-sm text-ink/70">@related.Excerpt</p>
                </a>
            }
        </div>
    </section>
}
