@using GaiaSkyline.Application.Content
@using GaiaSkyline.Application.Seo
@model GaiaSkyline.Web.Models.SeoAdminViewModel
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "SEO";
    PageMetaOverrideDto? Ovr(string key, string lang) => Model.PageMeta.FirstOrDefault(p => p.PageKey == key && string.Equals(p.LanguageCode, lang, StringComparison.OrdinalIgnoreCase));
    string? Title(string key, string lang) => Ovr(key, lang)?.Title;
    string? Desc(string key, string lang) => Ovr(key, lang)?.Description;
    var idx = 0;
}

<div class="max-w-4xl">
    <h1 class="font-display text-2xl font-semibold">SEO</h1>

    <!-- ========== Core Web Vitals (field) ========== -->
    <section class="mt-6">
        <h2 class="font-display text-sm font-semibold text-ink/80">Core Web Vitals (field)</h2>
        <p class="mt-1 text-xs text-ink/55">p75 of real visitors since the app last started (in-memory; resets on restart).</p>
        @if (Model.Vitals.Count == 0)
        {
            <p class="mt-2 text-sm text-ink/55">No field data yet — visit the public site to collect samples.</p>
        }
        else
        {
            <div class="mt-3 grid gap-3 grid-cols-2 sm:grid-cols-5">
                @foreach (var v in Model.Vitals)
                {
                    var color = v.Rating == "good" ? "text-green-700" : v.Rating == "poor" ? "text-clay" : "text-amber-600";
                    <div class="rounded-md border border-fog bg-white p-3">
                        <div class="text-xs uppercase tracking-wide text-ink/40">@v.Name</div>
                        <div class="mt-1 text-lg font-semibold @color">@(v.Name == "CLS" ? v.P75.ToString("0.00") : Math.Round(v.P75).ToString("0"))@v.Unit</div>
                        <div class="text-xs text-ink/40">@v.SampleCount samples · @v.Rating</div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ========== Warnings ========== -->
    <section class="mt-6">
        <h2 class="font-display text-sm font-semibold text-ink/80">Warnings (@Model.Warnings.Count)</h2>
        @if (Model.Warnings.Count == 0)
        {
            <p class="mt-2 text-sm text-ink/55">No SEO issues found.</p>
        }
        else
        {
            <ul class="mt-2 space-y-1">
                @foreach (var w in Model.Warnings)
                {
                    <li class="flex items-start gap-2 text-sm">
                        <span class="mt-0.5 inline-block rounded px-1.5 py-0.5 text-[10px] uppercase tracking-wide bg-clay/10 text-clay">@w.Category</span>
                        @if (w.Link is not null)
                        {
                            <a class="text-ink/80 hover:text-clay hover:underline" href="@w.Link">@w.Message</a>
                        }
                        else
                        {
                            <span class="text-ink/80">@w.Message</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <!-- ========== Per-page meta ========== -->
    <section class="mt-6">
        <h2 class="font-display text-sm font-semibold text-ink/80">Page meta</h2>
        <p class="mt-1 text-xs text-ink/55">Override the &lt;title&gt; and meta description per page and language. Leave blank to keep the built-in default. Target: title 50–60, description 150–160 characters. (Each story's meta is edited with the story.)</p>

        <div id="seo-preview" class="mt-3 rounded-md border border-fog bg-white p-4" hidden>
            <p class="text-xs uppercase tracking-wide text-ink/40">Google preview</p>
            <p id="seo-prev-url" class="mt-1 text-xs text-[#006621]"></p>
            <p id="seo-prev-title" class="text-lg text-[#1a0dab] leading-tight"></p>
            <p id="seo-prev-desc" class="text-sm text-ink/70"></p>
        </div>

        <form method="post" action="/admin/seo/page-meta" class="mt-3 space-y-5" data-seo-meta>
            @Html.AntiForgeryToken()
            @foreach (var pg in SeoPages.All)
            {
                <div class="rounded-md border border-fog bg-white p-4">
                    <h3 class="text-sm font-semibold text-ink/80">@pg.Label <span class="font-mono text-xs text-ink/40">/@pg.Key</span></h3>
                    <div class="mt-2 space-y-3">
                        @foreach (var lang in ContentLanguages.All)
                        {
                            var i = idx++;
                            var ovr = Ovr(pg.Key, lang);
                            var canIndex = ovr?.NoIndex != true; // no override row → indexable + followable
                            var canFollow = ovr?.NoFollow != true;
                            <div class="grid gap-2 sm:grid-cols-[2.5rem_1fr]">
                                <span class="text-xs font-semibold text-river pt-2">@ContentLanguages.ShortLabel(lang)</span>
                                <div class="space-y-1">
                                    <input type="hidden" name="items[@i].PageKey" value="@pg.Key" />
                                    <input type="hidden" name="items[@i].LanguageCode" value="@lang" />
                                    <div class="flex items-center gap-2">
                                        <input name="items[@i].Title" value="@Title(pg.Key, lang)" maxlength="200" placeholder="Title (default kept if blank)"
                                               data-seo-field="title" data-page="/@pg.Key" data-lang="@lang" data-min="50" data-max="60"
                                               class="w-full rounded-md border border-fog px-2 py-1 text-sm" />
                                        <span data-counter class="text-xs text-ink/40 w-12 text-right">0/60</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <input name="items[@i].Description" value="@Desc(pg.Key, lang)" maxlength="400" placeholder="Meta description (default kept if blank)"
                                               data-seo-field="desc" data-page="/@pg.Key" data-lang="@lang" data-min="150" data-max="160"
                                               class="w-full rounded-md border border-fog px-2 py-1 text-sm" />
                                        <span data-counter class="text-xs text-ink/40 w-12 text-right">0/160</span>
                                    </div>
                                    <div class="flex items-center gap-4 pt-0.5">
                                        <label class="inline-flex items-center gap-1.5 text-xs text-ink/60">
                                            <input type="checkbox" name="items[@i].Index" value="true" @(canIndex ? "checked" : null)
                                                   data-robots="index" data-page="/@pg.Key" data-lang="@lang" />
                                            <span>Index</span>
                                        </label>
                                        <label class="inline-flex items-center gap-1.5 text-xs text-ink/60">
                                            <input type="checkbox" name="items[@i].Follow" value="true" @(canFollow ? "checked" : null)
                                                   data-robots="follow" data-page="/@pg.Key" data-lang="@lang" />
                                            <span>Follow</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            <button type="submit" class="bg-river text-white rounded-md px-5 py-2 text-sm">Save page meta</button>
        </form>
    </section>

    <!-- ========== Sitemap preview ========== -->
    <section class="mt-10">
        <h2 class="font-display text-sm font-semibold text-ink/80">Sitemap preview</h2>
        <p class="mt-1 text-xs text-ink/55">
            The URLs in <a class="underline" href="/sitemap.xml" target="_blank" rel="noopener">/sitemap.xml</a>.
            A page+language marked <span class="font-semibold">noindex</span> above is dropped from the sitemap (shown struck through).
        </p>
        <div class="mt-3 rounded-md border border-fog bg-white divide-y divide-fog">
            @foreach (var entry in Model.Sitemap)
            {
                var anyIncluded = entry.Languages.Any(l => l.Included);
                <div class="p-3 @(anyIncluded ? "" : "opacity-50")">
                    <div class="font-mono text-xs text-ink/70">/@entry.Path</div>
                    <div class="mt-1 flex flex-wrap gap-3">
                        @foreach (var lang in entry.Languages)
                        {
                            if (lang.Included)
                            {
                                <a class="text-xs text-river hover:underline" href="@lang.Url" target="_blank" rel="noopener">@lang.Culture</a>
                            }
                            else
                            {
                                <span class="text-xs text-ink/40 line-through" title="noindex — excluded from the sitemap">@lang.Culture</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ========== Redirects ========== -->
    <section class="mt-10 rounded-md border border-fog bg-white p-5">
        <h2 class="font-display text-sm font-semibold text-ink/80">Add a redirect</h2>
        <p class="mt-1 text-xs text-ink/55">Site-relative paths, e.g. <code>/en/old-page</code> → <code>/en/new-page</code>. A redirect that would form a loop is rejected.</p>
        <form method="post" action="/admin/seo/redirects" class="mt-3 grid gap-3 sm:grid-cols-[1fr_1fr_auto_auto] sm:items-end">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-semibold text-river" for="fromPath">From</label>
                <input id="fromPath" name="fromPath" required placeholder="/en/old-page"
                       class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm font-mono" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-river" for="toPath">To</label>
                <input id="toPath" name="toPath" required placeholder="/en/new-page"
                       class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm font-mono" />
            </div>
            <label class="inline-flex items-center gap-2 text-sm pb-2">
                <input name="permanent" type="checkbox" value="true" checked />
                <span>301 (permanent)</span>
            </label>
            <button type="submit" class="bg-river text-white rounded-md px-4 py-2 text-sm">Add</button>
        </form>
    </section>

    <section class="mt-6">
        <h2 class="font-display text-sm font-semibold text-ink/80">Redirects (@Model.Redirects.Count)</h2>
        @if (Model.Redirects.Count == 0)
        {
            <p class="mt-2 text-sm text-ink/55">No redirects yet.</p>
        }
        else
        {
            <table class="mt-2 w-full text-sm">
                <thead class="text-left text-ink/50 border-b border-fog">
                    <tr><th class="py-2">From</th><th>To</th><th>Type</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Redirects)
                    {
                        <tr class="border-b border-fog">
                            <td class="py-2 font-mono text-xs">@r.FromPath</td>
                            <td class="font-mono text-xs">@r.ToPath</td>
                            <td class="text-xs">@(r.Permanent ? "301" : "302")</td>
                            <td class="text-right">
                                <form method="post" action="/admin/seo/redirects/@r.Id/delete" data-confirm="Remove this redirect?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-xs text-clay hover:underline">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

<script src="~/js/seo-admin.js" asp-append-version="true"></script>
