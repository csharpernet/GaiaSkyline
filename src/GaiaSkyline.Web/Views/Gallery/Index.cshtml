@model GalleryViewModel
<div class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="font-display text-4xl sm:text-5xl font-semibold">Photo gallery</h1>
    <p class="mt-3 text-lg text-ink/70">The apartment, the balcony view over the Douro, and the hot tub.</p>

    @if (Model.Images.Count == 0)
    {
        <p class="mt-10 text-ink/60">Photos coming soon.</p>
    }
    else
    {
        <ul id="gallery-grid" class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
            @for (var i = 0; i < Model.Images.Count; i++)
            {
                var img = Model.Images[i].Asset;
                <li>
                    <button type="button" data-gallery-open="@i"
                            class="block w-full overflow-hidden rounded-lg group focus-visible:outline focus-visible:outline-2 focus-visible:outline-clay"
                            aria-label="Open photo @(i + 1) of @Model.Images.Count">
                        <img src="@img.BlobUri" alt="@img.Alt" width="@img.Width" height="@img.Height"
                             loading="@(i == 0 ? "eager" : "lazy")"
                             class="w-full aspect-[3/2] object-cover group-hover:scale-[1.02] transition-transform duration-200" />
                    </button>
                </li>
            }
        </ul>
    }
</div>

@await Html.PartialAsync("_Lightbox")

@section Scripts {
    <script src="~/js/gallery.js" defer></script>
}
