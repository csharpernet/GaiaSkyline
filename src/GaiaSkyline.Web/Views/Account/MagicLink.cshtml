@model MagicLinkViewModel
@{
    Layout = "_Layout";
}

<div class="max-w-md mx-auto px-6 py-16">
    <h1 class="font-display text-3xl font-semibold">Access your booking</h1>
    <p class="mt-3 text-sm text-ink/70">
        No account needed. Enter your booking reference and email and we'll send you a secure, single-use link.
    </p>

    <form asp-action="MagicLink" method="post" class="mt-8 space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-clay text-sm"></div>
        <div>
            <label asp-for="Reference" class="block text-sm font-semibold text-river">Booking reference</label>
            <input asp-for="Reference" autocomplete="off" placeholder="GS-XXXX"
                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 bg-white" />
            <span asp-validation-for="Reference" class="text-clay text-sm"></span>
        </div>
        <div>
            <label asp-for="Email" class="block text-sm font-semibold text-river">Email</label>
            <input asp-for="Email" type="email" autocomplete="email"
                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 bg-white" />
            <span asp-validation-for="Email" class="text-clay text-sm"></span>
        </div>
        <button type="submit"
                class="w-full bg-clay text-white px-6 py-3 rounded-md hover:opacity-90 transition-opacity">
            Send access link
        </button>
    </form>
</div>
