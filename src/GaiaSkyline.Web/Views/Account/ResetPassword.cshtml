@model ResetPasswordViewModel
@{
    Layout = "_Layout";
}

<div class="max-w-md mx-auto px-6 py-16">
    <h1 class="font-display text-3xl font-semibold">Choose a new password</h1>

    <form asp-action="ResetPassword" method="post" class="mt-8 space-y-5">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="text-clay text-sm"></div>

        <div>
            <label asp-for="Password" class="block text-sm font-semibold text-river">New password</label>
            <input asp-for="Password" type="password" autocomplete="new-password"
                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 bg-white" />
            <p class="mt-1 text-xs text-ink/60">At least 12 characters.</p>
            <span asp-validation-for="Password" class="text-clay text-sm"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-river">Confirm password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 bg-white" />
            <span asp-validation-for="ConfirmPassword" class="text-clay text-sm"></span>
        </div>

        <button type="submit"
                class="w-full bg-clay text-white px-6 py-3 rounded-md hover:opacity-90 transition-opacity">
            Reset password
        </button>
    </form>
</div>
