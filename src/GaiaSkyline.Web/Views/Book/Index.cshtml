@model BookPageViewModel
@{
    Layout = "_Layout";
    var copy = Model.Copy;
    var slug = SupportedCultures.SlugForCulture(System.Globalization.CultureInfo.CurrentUICulture.Name);
    var maxGuests = Model.MaxGuests;
}

<div class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="font-display text-4xl sm:text-5xl font-semibold">@copy.TextOr("book.title", "Book your stay")</h1>
    <p class="mt-3 text-lg text-ink/70 max-w-2xl">@copy.TextOr("book.subtitle", "Pick your dates and guests to see the total.")</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-[2fr,1fr]">
        <form id="booking-form" data-slug="@slug" data-max-guests="@maxGuests" novalidate>
            <fieldset class="grid gap-6 md:grid-cols-2">
                <legend class="sr-only">Dates</legend>
                <div>
                    <label for="checkin-cal" class="block text-sm font-semibold text-river">@copy.TextOr("book.checkin_label", "Check-in")</label>
                    <input id="checkin-cal" type="text" readonly inputmode="none"
                           class="mt-2 w-full rounded-md border border-fog px-3 py-2 bg-white" placeholder="—" />
                </div>
                <div>
                    <label for="checkout-cal" class="block text-sm font-semibold text-river">@copy.TextOr("book.checkout_label", "Check-out")</label>
                    <input id="checkout-cal" type="text" readonly inputmode="none"
                           class="mt-2 w-full rounded-md border border-fog px-3 py-2 bg-white" placeholder="—" />
                </div>
            </fieldset>

            <fieldset class="mt-8">
                <legend class="text-sm font-semibold text-river">@copy.TextOr("book.guests_label", "Guests")</legend>
                <div class="mt-3 grid grid-cols-3 gap-4 max-w-md">
                    <label class="text-sm">@copy.TextOr("book.adults_label", "Adults")
                        <select id="adults" class="mt-1 w-full rounded-md border border-fog px-2 py-2 bg-white">
                            @for (var i = 1; i <= maxGuests; i++)
                            {
                                <option value="@i" selected="@(i == 2 ? "selected" : null)">@i</option>
                            }
                        </select>
                    </label>
                    <label class="text-sm">@copy.TextOr("book.children_label", "Children")
                        <select id="children" class="mt-1 w-full rounded-md border border-fog px-2 py-2 bg-white">
                            @for (var i = 0; i < maxGuests; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </label>
                    <label class="text-sm">@copy.TextOr("book.infants_label", "Infants")
                        <select id="infants" class="mt-1 w-full rounded-md border border-fog px-2 py-2 bg-white">
                            <option value="0">0</option>
                            <option value="1">1</option>
                        </select>
                    </label>
                </div>
                <p id="sofa-note" class="mt-3 text-sm text-ink/60" hidden>@copy.TextOr("book.sofa_note", "Above 4 guests, the extra guests sleep on the sofa bed.")</p>
            </fieldset>

            <div class="mt-8 max-w-xs">
                <label for="promo" class="block text-sm font-semibold text-river">@copy.TextOr("book.promo_label", "Promo code")</label>
                <input id="promo" type="text" autocomplete="off"
                       class="mt-2 w-full rounded-md border border-fog px-3 py-2 bg-white uppercase" />
            </div>

            <p class="mt-6 text-sm text-ink/60">@copy.TextOr("book.min_nights_note", "Minimum 3 nights (1 for last-minute stays within 7 days).")</p>
        </form>

        <aside class="lg:sticky lg:top-24 h-fit">
            <div class="rounded-lg border border-fog bg-white p-6 shadow-sm">
                <div id="quote-panel" aria-live="polite" class="min-h-24 text-sm">
                    <p class="text-ink/60">Select your dates to see the total.</p>
                </div>
                <button id="reserve" type="button" disabled
                        class="mt-6 w-full bg-clay text-white px-6 py-3 rounded-md text-lg hover:opacity-90 transition-opacity duration-200 disabled:opacity-40 disabled:cursor-not-allowed">
                    @copy.TextOr("book.reserve_cta", "Reserve")
                </button>
                <p class="mt-4 text-xs text-river text-center">@copy.TextOr("book.payment_methods_note", "Pay by card, Apple Pay, Google Pay or Multibanco.")</p>
                <ul class="mt-3 flex flex-wrap items-center justify-center gap-2 text-ink/70" aria-hidden="true">
                    <li class="text-xs font-semibold border border-fog rounded px-1.5 py-0.5">VISA</li>
                    <li class="text-xs font-semibold border border-fog rounded px-1.5 py-0.5">Mastercard</li>
                    <li class="text-xs font-semibold border border-fog rounded px-1.5 py-0.5">Multibanco</li>
                    <li class="text-xs font-semibold border border-fog rounded px-1.5 py-0.5">Apple&nbsp;Pay</li>
                    <li class="text-xs font-semibold border border-fog rounded px-1.5 py-0.5">Google&nbsp;Pay</li>
                </ul>
            </div>
        </aside>
    </div>
</div>

@section Head {
    <link rel="stylesheet" href="~/css/vendor/flatpickr.min.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/vendor/flatpickr.min.js" defer></script>
    <script src="~/js/book.js" defer></script>
}
