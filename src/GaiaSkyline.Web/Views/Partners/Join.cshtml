@model PartnerJoinViewModel
@{
    var slug = ViewContext.RouteData.Values["lang"];
}
<div class="max-w-2xl mx-auto px-6 py-12">
    <h1 class="font-display text-4xl font-semibold">Partner onboarding</h1>

    @if (Model.Completed)
    {
        <div class="mt-8 rounded-md border border-river/40 bg-river/5 p-5 text-lg" role="status">
            <p>Your partner account is ready. Welcome aboard!</p>
            <p class="mt-3">
                <a href="/en/account/login" class="font-semibold text-river hover:underline">Sign in</a>
                and open your <a href="/@slug/partners/dashboard" class="font-semibold text-river hover:underline">partner dashboard</a>.
            </p>
        </div>
    }
    else if (Model.Invite is null)
    {
        <p class="mt-6 rounded-md border border-clay/50 bg-clay/5 px-4 py-3 text-clay" role="alert">
            This invite link has expired or was already used. Reply to the invite email and the owner will send a fresh one.
        </p>
    }
    else
    {
        <p class="mt-4 text-lg text-ink/80">
            Olá @Model.Invite.Name — your promo code is <strong class="font-mono">@Model.Invite.PromoCode</strong>.
            Choose a password, accept the terms and add payout details to activate it.
        </p>

        @if (Model.Error is not null)
        {
            <p class="mt-4 rounded-md border border-clay/50 bg-clay/5 px-4 py-3 text-clay" role="alert">@Model.Error</p>
        }

        <form method="post" action="/@slug/partners/join" class="mt-8 space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Token" value="@Model.Token" />

            <div>
                <label for="pj-password" class="block text-sm font-semibold">Password</label>
                <input id="pj-password" name="Password" type="password" required minlength="12" autocomplete="new-password"
                       class="mt-1 w-full rounded-md border border-fog px-3 py-2" />
                <p class="mt-1 text-xs text-ink/55">At least 12 characters; known-breached passwords are rejected.</p>
            </div>

            <fieldset class="rounded-md border border-fog p-4">
                <legend class="px-1 text-sm font-semibold">Payout details</legend>
                <div class="space-y-4">
                    <div>
                        <label for="pj-iban" class="block text-sm font-semibold">IBAN</label>
                        <input id="pj-iban" name="Iban" value="" required maxlength="42" autocomplete="off"
                               class="mt-1 w-full rounded-md border border-fog px-3 py-2 font-mono" />
                    </div>
                    <div>
                        <label for="pj-holder" class="block text-sm font-semibold">Account holder</label>
                        <input id="pj-holder" name="AccountHolder" required maxlength="200"
                               class="mt-1 w-full rounded-md border border-fog px-3 py-2" />
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label for="pj-tax" class="block text-sm font-semibold">NIF / tax ID</label>
                            <input id="pj-tax" name="TaxId" required maxlength="50"
                                   class="mt-1 w-full rounded-md border border-fog px-3 py-2" />
                        </div>
                        <div>
                            <label for="pj-country" class="block text-sm font-semibold">Country (2 letters)</label>
                            <input id="pj-country" name="Country" required maxlength="2" minlength="2" placeholder="PT"
                                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 uppercase" />
                        </div>
                    </div>
                </div>
            </fieldset>

            <details class="rounded-md border border-fog p-4">
                <summary class="cursor-pointer text-sm font-semibold">Partner terms</summary>
                <div class="prose mt-3 max-w-none text-sm text-ink/80">@Html.Raw(Model.TermsHtml)</div>
            </details>

            <label class="flex items-start gap-2 text-sm">
                <input name="AcceptTerms" type="checkbox" value="true" class="mt-1" required />
                <span>I accept the partner terms.</span>
            </label>

            <button type="submit"
                    class="rounded-md bg-clay px-6 py-3 text-white font-semibold hover:bg-clay/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-clay">
                Activate my partner account
            </button>
        </form>
    }
</div>
