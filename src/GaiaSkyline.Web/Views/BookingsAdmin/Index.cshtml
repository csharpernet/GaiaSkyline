@using GaiaSkyline.Domain.Bookings
@model GaiaSkyline.Web.Models.BookingsAdminIndexViewModel
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Bookings";

    string StatusClass(BookingStatus s) => s switch
    {
        BookingStatus.Confirmed or BookingStatus.CheckedIn => "border-river text-river",
        BookingStatus.AwaitingPayment or BookingStatus.PartiallyRefunded => "border-amber-600 text-amber-600",
        BookingStatus.Cancelled or BookingStatus.Refunded => "border-clay text-clay",
        _ => "border-ink/30 text-ink/60",
    };
}

<div class="max-w-6xl">
    <h1 class="font-display text-2xl font-semibold">Bookings</h1>
    <p class="mt-1 text-sm text-ink/70">@Model.Bookings.Count booking(s). Filter by status, guest or dates.</p>

    <form method="get" action="/admin/bookings" class="mt-5 grid gap-3 sm:grid-cols-[1fr_1fr_auto_auto_auto] sm:items-end">
        <div>
            <label class="block text-xs font-semibold text-river" for="q">Search</label>
            <input id="q" name="q" value="@Model.Query" placeholder="Reference, guest name or email"
                   class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm" />
        </div>
        <div>
            <label class="block text-xs font-semibold text-river" for="status">Status</label>
            <select id="status" name="status" class="mt-1 w-full rounded-md border border-fog px-3 py-2 text-sm">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<BookingStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s.ToString())">@s</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-xs font-semibold text-river" for="from">Check-in from</label>
            <input id="from" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))"
                   class="mt-1 rounded-md border border-fog px-3 py-2 text-sm" />
        </div>
        <div>
            <label class="block text-xs font-semibold text-river" for="to">to</label>
            <input id="to" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))"
                   class="mt-1 rounded-md border border-fog px-3 py-2 text-sm" />
        </div>
        <button type="submit" class="bg-river text-white rounded-md px-4 py-2 text-sm">Filter</button>
    </form>

    @if (Model.Bookings.Count == 0)
    {
        <p class="mt-8 text-sm text-ink/55">No bookings match.</p>
    }
    else
    {
        <table class="mt-6 w-full text-sm">
            <thead class="text-left text-ink/50 border-b border-fog">
                <tr><th class="py-2">Reference</th><th>Guest</th><th>Dates</th><th>Nights</th><th>Status</th><th>Total</th><th>Payment</th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Bookings)
                {
                    <tr class="border-b border-fog hover:bg-stone/40">
                        <td class="py-2">
                            <a href="/admin/bookings/@b.Id" class="font-mono text-xs text-river hover:underline">@b.ReferenceCode</a>
                        </td>
                        <td>
                            <div class="font-medium text-ink">@b.GuestName</div>
                            <div class="text-xs text-ink/55">@b.GuestEmail</div>
                        </td>
                        <td class="text-xs text-ink/70">@b.CheckIn.ToString("yyyy-MM-dd") → @b.CheckOut.ToString("yyyy-MM-dd")</td>
                        <td class="text-xs text-ink/70">@b.Nights</td>
                        <td>
                            <span class="text-xs uppercase tracking-wide border rounded px-2 py-0.5 @StatusClass(b.Status)">@b.Status</span>
                        </td>
                        <td class="text-xs text-ink/80">€@b.Total.ToString("0.00")</td>
                        <td class="text-xs text-ink/60">@(b.PaymentMethodType ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
