@using GaiaSkyline.Application.Media
@using GaiaSkyline.Domain.Media
@model IReadOnlyList<GaiaSkyline.Application.Media.MediaLibraryItemDto>
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Media";
    var kind = ViewData["Kind"] as string;
    string Thumb(MediaLibraryItemDto m) =>
        m.Kind == MediaKind.Image && m.BlobUri.EndsWith("-1600.jpg", StringComparison.OrdinalIgnoreCase)
            ? m.BlobUri[..^"-1600.jpg".Length] + "-400.jpg"
            : m.BlobUri;
    string Kb(long bytes) => (bytes / 1024.0).ToString("0.#") + " KB";
    string TabClass(string? value) =>
        string.Equals(kind, value, StringComparison.OrdinalIgnoreCase) || (value is null && string.IsNullOrEmpty(kind))
            ? "bg-river text-white" : "bg-white border border-fog text-ink/70 hover:bg-stone";
}

<div class="max-w-6xl">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="font-display text-2xl font-semibold">Media</h1>
            <p class="mt-1 text-sm text-ink/70">@Model.Count asset(s). Every image needs alt text in all five languages before it can go on a public page.</p>
        </div>
        <div class="flex gap-1 text-sm">
            <a href="/admin/media" class="rounded-md px-3 py-1.5 @TabClass(null)">All</a>
            <a href="/admin/media?kind=image" class="rounded-md px-3 py-1.5 @TabClass("image")">Images</a>
            <a href="/admin/media?kind=video" class="rounded-md px-3 py-1.5 @TabClass("video")">Videos</a>
        </div>
    </div>

    <!-- Upload drop zone -->
    <div id="media-dropzone" data-upload-url="/api/admin/media"
         class="mt-4 rounded-lg border-2 border-dashed border-fog bg-white px-6 py-8 text-center text-sm text-ink/60">
        <p><strong>Drag &amp; drop images here</strong> or
            <label class="text-river underline cursor-pointer">browse
                <input id="media-file-input" type="file" accept="image/*" multiple class="sr-only" />
            </label>
        </p>
        <p class="mt-1 text-xs text-ink/45">Each upload generates AVIF + WebP + JPEG at 400/800/1600 and a blurred preview. Add alt text next.</p>
        <div id="media-upload-status" class="mt-2 text-xs text-river" role="status" aria-live="polite"></div>
    </div>

    <div class="mt-3 flex items-center gap-4 text-xs text-ink/60">
        <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full bg-river/60"></span> ready for public</span>
        <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full bg-clay"></span> needs alt text</span>
    </div>

    @if (Model.Count == 0)
    {
        <p class="mt-6 text-sm text-ink/50">No media yet. Upload an image to get started.</p>
    }
    else
    {
        <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            @foreach (var m in Model)
            {
                <a href="/admin/media/@m.Id" class="block rounded-md border border-fog bg-white overflow-hidden hover:shadow-md transition-shadow">
                    <div class="relative aspect-[3/2] bg-fog">
                        @if (m.Kind == MediaKind.Image)
                        {
                            <img src="@Thumb(m)" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                        }
                        else
                        {
                            <div class="absolute inset-0 flex items-center justify-center text-ink/40 text-xs uppercase tracking-wide">Video</div>
                        }
                        <span class="absolute top-1 right-1 inline-block w-2.5 h-2.5 rounded-full @(m.ReadyForPublic ? "bg-river/70" : "bg-clay")"
                              title="@(m.ReadyForPublic ? "Ready for public use" : "Needs alt text in all languages")"></span>
                    </div>
                    <div class="px-2 py-1.5 text-[11px] text-ink/60">
                        <div>@m.Width×@m.Height · @Kb(m.ByteSize)</div>
                        <div class="mt-0.5 flex items-center justify-between">
                            <span>alt: @(m.LanguagesWithAlt.Count)/5</span>
                            <span title="Used in @m.UsageCount place(s)">@(m.UsageCount > 0 ? $"used ×{m.UsageCount}" : "unused")</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

<script src="~/js/media-admin.js" asp-append-version="true"></script>
