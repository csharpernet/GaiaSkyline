@using GaiaSkyline.Application.Media
@model GaiaSkyline.Application.Media.GalleryManagerDto
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Home gallery";
    string Thumb(string blobUri) =>
        blobUri.EndsWith("-1600.jpg", StringComparison.OrdinalIgnoreCase)
            ? blobUri[..^"-1600.jpg".Length] + "-400.jpg"
            : blobUri;
}

<div class="max-w-5xl" data-gallery data-collection="@Model.Key" data-save-url="/api/admin/media/collections/@Model.Key/items">
    <nav class="text-sm text-ink/60 mb-2">
        <a href="/admin/media" class="text-river hover:underline">Media</a>
        <span class="mx-1">/</span>
        <span>@Model.DisplayName</span>
    </nav>

    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="font-display text-2xl font-semibold">Home gallery</h1>
            <p class="mt-1 text-sm text-ink/70">Drag to reorder, pick the hero, add or remove images. Save to publish the changes.</p>
        </div>
        <button type="button" id="gallery-save" class="shrink-0 bg-river text-white rounded-md px-4 py-2 text-sm">Save gallery</button>
    </div>
    <div id="gallery-status" class="mt-2 text-xs text-river" role="status" aria-live="polite"></div>

    <h2 class="mt-6 font-display text-sm font-semibold text-ink/80">In the gallery (@Model.Items.Count)</h2>
    <ul id="gallery-items" class="mt-2 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        @foreach (var item in Model.Items)
        {
            <li data-asset-id="@item.MediaAssetId" data-ready="@item.ReadyForPublic.ToString().ToLowerInvariant()" draggable="true"
                class="relative rounded-md border border-fog bg-white overflow-hidden cursor-move">
                <div class="relative aspect-[3/2] bg-fog">
                    <img src="@Thumb(item.BlobUri)" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                    @if (!item.ReadyForPublic)
                    {
                        <span class="absolute top-1 right-1 text-[10px] uppercase tracking-wide bg-clay text-white rounded px-1" title="Needs alt text in all languages">needs alt</span>
                    }
                </div>
                <div class="flex items-center justify-between px-2 py-1.5 text-xs">
                    <label class="flex items-center gap-1"><input type="radio" name="hero" value="@item.MediaAssetId" data-hero @(item.IsHero ? "checked" : "") /> hero</label>
                    <button type="button" data-remove class="text-clay hover:underline">Remove</button>
                </div>
            </li>
        }
    </ul>

    <h2 class="mt-8 font-display text-sm font-semibold text-ink/80">Available images</h2>
    <p class="mt-1 text-xs text-ink/55">Images in the library not yet in the gallery. Click to add.</p>
    <ul id="gallery-available" class="mt-2 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        @foreach (var item in Model.Available)
        {
            <li data-asset-id="@item.MediaAssetId" data-ready="@item.ReadyForPublic.ToString().ToLowerInvariant()" class="rounded-md border border-fog bg-white overflow-hidden">
                <div class="relative aspect-[3/2] bg-fog">
                    <img src="@Thumb(item.BlobUri)" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                    @if (!item.ReadyForPublic)
                    {
                        <span class="absolute top-1 right-1 text-[10px] uppercase tracking-wide bg-clay text-white rounded px-1" title="Needs alt text in all languages">needs alt</span>
                    }
                </div>
                <button type="button" data-add class="w-full px-2 py-1.5 text-xs text-river hover:bg-stone">Add to gallery</button>
            </li>
        }
        @if (Model.Available.Count == 0)
        {
            <li class="col-span-full text-xs text-ink/50">All library images are already in the gallery.</li>
        }
    </ul>
</div>

<script src="~/js/gallery-admin.js" asp-append-version="true"></script>
