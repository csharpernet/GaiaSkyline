@using System.Globalization
@model GaiaSkyline.Application.Auditing.AuditLogPage
@{
    Layout = "_AdminShell";
    ViewData["Title"] = "Audit log";
    var q = Context.Request.Query;
    string Sel(string key) => q[key].ToString();
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));

    string PageLink(int page)
    {
        var parts = new List<string> { $"page={page}" };
        if (!string.IsNullOrEmpty(Sel("action"))) parts.Add("action=" + Uri.EscapeDataString(Sel("action")));
        if (!string.IsNullOrEmpty(Sel("entityType"))) parts.Add("entityType=" + Uri.EscapeDataString(Sel("entityType")));
        if (!string.IsNullOrEmpty(Sel("from"))) parts.Add("from=" + Sel("from"));
        if (!string.IsNullOrEmpty(Sel("to"))) parts.Add("to=" + Sel("to"));
        return "/admin/audit?" + string.Join("&", parts);
    }
}

<div class="max-w-6xl">
    <h1 class="font-display text-2xl font-semibold">Audit log</h1>
    <p class="mt-1 text-sm text-ink/70">@Model.TotalCount event(s). Newest first.</p>

    <form method="get" action="/admin/audit" class="mt-4 flex flex-wrap items-end gap-3 text-sm">
        <div>
            <label for="action" class="block text-xs font-semibold text-river">Action</label>
            <select id="action" name="action" class="mt-1 rounded-md border border-fog px-2 py-1.5 bg-white">
                <option value="">All</option>
                @foreach (var a in Model.Actions)
                {
                    <option value="@a" selected="@(Sel("action") == a)">@a</option>
                }
            </select>
        </div>
        <div>
            <label for="entityType" class="block text-xs font-semibold text-river">Entity</label>
            <select id="entityType" name="entityType" class="mt-1 rounded-md border border-fog px-2 py-1.5 bg-white">
                <option value="">All</option>
                @foreach (var et in Model.EntityTypes)
                {
                    <option value="@et" selected="@(Sel("entityType") == et)">@et</option>
                }
            </select>
        </div>
        <div>
            <label for="from" class="block text-xs font-semibold text-river">From</label>
            <input id="from" name="from" type="date" value="@Sel("from")" class="mt-1 rounded-md border border-fog px-2 py-1.5 bg-white" />
        </div>
        <div>
            <label for="to" class="block text-xs font-semibold text-river">To</label>
            <input id="to" name="to" type="date" value="@Sel("to")" class="mt-1 rounded-md border border-fog px-2 py-1.5 bg-white" />
        </div>
        <button type="submit" class="bg-river text-white rounded-md px-4 py-2">Filter</button>
        <a href="/admin/audit" class="text-river hover:underline">Reset</a>
    </form>

    <div class="mt-4 overflow-x-auto bg-white border border-fog rounded-md">
        <table class="w-full text-sm">
            <thead class="text-left text-xs uppercase tracking-wide text-ink/50 border-b border-fog">
                <tr>
                    <th class="px-3 py-2">When (UTC)</th>
                    <th class="px-3 py-2">Action</th>
                    <th class="px-3 py-2">Actor</th>
                    <th class="px-3 py-2">IP</th>
                    <th class="px-3 py-2">Entity</th>
                    <th class="px-3 py-2">Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="px-3 py-6 text-center text-ink/50">No events match these filters.</td></tr>
                }
                @foreach (var e in Model.Items)
                {
                    var actor = e.ActorEmail ?? (e.ActorUserId?.ToString() ?? "anonymous");
                    var entity = e.EntityType is null ? "" : $"{e.EntityType}{(e.EntityId is null ? "" : $" · {e.EntityId}")}";
                    <tr class="border-b border-fog/60 align-top">
                        <td class="px-3 py-2 whitespace-nowrap text-ink/70">@e.UtcAt.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
                        <td class="px-3 py-2 font-mono text-xs">@e.Action</td>
                        <td class="px-3 py-2">@actor</td>
                        <td class="px-3 py-2 text-ink/60">@(e.ActorIp ?? "")</td>
                        <td class="px-3 py-2 text-ink/70">@entity</td>
                        <td class="px-3 py-2 text-ink/60 max-w-xs truncate" title="@e.DetailsJson">@e.DetailsJson</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="mt-4 flex items-center justify-between text-sm">
            <div>
                @if (Model.Page > 1)
                {
                    <a href="@PageLink(Model.Page - 1)" class="text-river hover:underline">← Previous</a>
                }
            </div>
            <span class="text-ink/60">Page @Model.Page of @totalPages</span>
            <div>
                @if (Model.Page < totalPages)
                {
                    <a href="@PageLink(Model.Page + 1)" class="text-river hover:underline">Next →</a>
                }
            </div>
        </div>
    }
</div>
