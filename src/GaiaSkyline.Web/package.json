{
  "name": "gaiaskyline-web",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for the GaiaSkyline web front-end (compiled at build time via MSBuild).",
  "scripts": {
    "build:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify",
    "watch:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
