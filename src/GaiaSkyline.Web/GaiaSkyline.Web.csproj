<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep the Node toolchain out of the C# compilation / content globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>
    <UserSecretsId>f4d3f5cc-7a82-464b-9137-4aeb60246d96</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GaiaSkyline.Application\GaiaSkyline.Application.csproj" />
    <ProjectReference Include="..\GaiaSkyline.Infrastructure\GaiaSkyline.Infrastructure.csproj" />
    <ProjectReference Include="..\GaiaSkyline.BackgroundJobs\GaiaSkyline.BackgroundJobs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
  </ItemGroup>

  <!--
    Front-end is compiled at build time via a Node step (see ADR 0001): Tailwind CSS plus
    self-hosted vendor JS (web-vitals). The generated outputs are git-ignored and produced
    incrementally: MSBuild reruns the step only when a source/markup file changes.
  -->
  <ItemGroup>
    <FrontendInput Include="package.json;tailwind.config.js;copy-vendor.js;Styles\app.css" />
    <FrontendInput Include="Views\**\*.cshtml" />
  </ItemGroup>

  <Target Name="FrontendBuild" BeforeTargets="AssignTargetPaths;Build" Inputs="@(FrontendInput)" Outputs="wwwroot\css\app.css;wwwroot\js\vendor\web-vitals.iife.js;wwwroot\js\vendor\maplibre-gl.js;wwwroot\js\vendor\flatpickr.min.js">
    <Message Importance="high" Text="GaiaSkyline: building front-end (npm run build)..." />
    <Exec Command="npm install --no-fund --no-audit --loglevel=error" Condition="!Exists('$(MSBuildProjectDirectory)\node_modules')" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
