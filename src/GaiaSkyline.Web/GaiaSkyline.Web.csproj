<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep the Node toolchain out of the C# compilation / content globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GaiaSkyline.Application\GaiaSkyline.Application.csproj" />
    <ProjectReference Include="..\GaiaSkyline.Infrastructure\GaiaSkyline.Infrastructure.csproj" />
    <ProjectReference Include="..\GaiaSkyline.BackgroundJobs\GaiaSkyline.BackgroundJobs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
  </ItemGroup>

  <!--
    Tailwind is compiled at build time via a Node step (see ADR 0001).
    The compiled output (wwwroot/css/app.css) is generated, git-ignored, and produced
    incrementally: MSBuild reruns Tailwind only when a source/markup file changes.
  -->
  <ItemGroup>
    <TailwindInput Include="package.json;tailwind.config.js;Styles\app.css" />
    <TailwindInput Include="Views\**\*.cshtml" />
  </ItemGroup>

  <Target Name="TailwindBuild"
          BeforeTargets="AssignTargetPaths;Build"
          Inputs="@(TailwindInput)"
          Outputs="wwwroot\css\app.css">
    <Message Importance="high" Text="GaiaSkyline: compiling Tailwind CSS (npm run build:css)..." />
    <Exec Command="npm install --no-fund --no-audit --loglevel=error"
          Condition="!Exists('$(MSBuildProjectDirectory)\node_modules')"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="npm run build:css"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
