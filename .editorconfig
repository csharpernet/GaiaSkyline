root = true

# =====================================================================
# GaiaSkyline — code style & analyzer configuration
# Keep this in sync with `dotnet format` (CI runs --verify-no-changes).
# =====================================================================

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,js,jsx,ts,css,html,cshtml,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Files consumed by Linux tooling (Docker, shell, CI) stay LF.
[*.{yml,yaml,sh}]
end_of_line = lf

[Dockerfile]
end_of_line = lf

# ---------------------------------------------------------------------
# C# files
# ---------------------------------------------------------------------
[*.cs]
# this. preferences
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Language keywords vs BCL types
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Modern language features
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_prefer_primary_constructors = true:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Accessibility modifiers required
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Null / pattern preferences
csharp_style_throw_expression = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# ---------------------------------------------------------------------
# Analyzer rule tuning (applies solution-wide)
# ---------------------------------------------------------------------
# CA1515: "make public types internal" — inappropriate for library public APIs.
dotnet_diagnostic.CA1515.severity = none
# CA1716: identifier conflicts with a reserved keyword in another language (VB's "Property").
# The domain vocabulary (Property) is fixed by the spec and this is not a cross-language library.
dotnet_diagnostic.CA1716.severity = none
# CA1848: LoggerMessage delegates — overkill for a foundation stage.
dotnet_diagnostic.CA1848.severity = none
# CA2007: ConfigureAwait(false) — not needed in ASP.NET Core (no sync context).
dotnet_diagnostic.CA2007.severity = none
# CA1812: "uninstantiated internal class" — false positive for types created via DI/EF/reflection
# (EF IEntityTypeConfiguration implementations, design-time factories, etc.).
dotnet_diagnostic.CA1812.severity = none

# ---------------------------------------------------------------------
# EF Core migrations are generated code.
# ---------------------------------------------------------------------
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# ---------------------------------------------------------------------
# Test projects: relax rules that don't fit test code.
# ---------------------------------------------------------------------
[tests/**/*.cs]
# CA1707: underscores in member names (test method naming convention).
dotnet_diagnostic.CA1707.severity = none
# CA1861: constant arrays as arguments (fine in test data).
dotnet_diagnostic.CA1861.severity = none
# CA2000: dispose objects — test fixtures manage lifetimes explicitly.
dotnet_diagnostic.CA2000.severity = none
# CA1812: uninstantiated internal classes (test fixtures / DTOs).
dotnet_diagnostic.CA1812.severity = none
