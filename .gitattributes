# Normalize line endings so `dotnet format --verify-no-changes` is stable on
# both Windows dev machines and the Linux CI runner.
* text=auto

# Source treated as CRLF (matches .editorconfig).
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.json      text eol=crlf
*.cshtml    text eol=crlf
*.css       text eol=crlf
*.js        text eol=crlf

# Files consumed by Linux tooling stay LF.
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf

# Binary
*.ico       binary
*.png       binary
